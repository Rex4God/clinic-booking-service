APP
NODE_ENV=development
DEBUG=app:debug
APP_NAME=clinic-booking-api
PORT=9000

DATABASE_NAME=clinic-booking


MONGODB_URL=mongodb://127.0.0.1:27017


PUBLIC_API_URL=http://localhost:9000

API_KEYS=replace-with-a-long-random-key


CLINIC_TIMEZONE=Africa/Lagos

SEED_SLOTS_ON_START=true
SEED_SLOTS_DAYS=14


TRUST_PROXY=1


CORS_ORIGINS=http://localhost:3000


MAX_ACTIVE_BOOKINGS_PER_PATIENT=5
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MINUTES=15
BOOKING_RATE_LIMIT_MAX=10
BOOKING_RATE_LIMIT_WINDOW_MINUTES=15
PATIENT_RATE_LIMIT_MAX=5
PATIENT_RATE_LIMIT_WINDOW_MINUTES=1
SLOT_DURATION_MINUTES =60
